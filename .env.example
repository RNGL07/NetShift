# ---------------------------------------------------------------------------
# NetShift environment variables
#
# Copy to `.env.local` for local development. `.env.local` is gitignored;
# never commit a real key. On Vercel, set these under
# Project → Settings → Environment Variables.
#
# Names WITHOUT a VITE_ prefix are server-only: Vite refuses to expose them to
# the browser bundle, which is what keeps the service-role key, the Stripe
# secret key, and the Anthropic key off the client.
# ---------------------------------------------------------------------------

# --- Supabase (browser) ----------------------------------------------------
# Both of these are meant to be public. The anon key is safe in the browser
# precisely because row-level security, not the key, is what restricts access.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Supabase (server) -----------------------------------------------------
# Same project, read by the serverless functions.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# BYPASSES ROW-LEVEL SECURITY. Server-only, never prefixed with VITE_, never
# committed. Anyone holding this can read and write every user's data.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Anthropic -------------------------------------------------------------
# Server-only. Used by api/ai/* to parse documents and generate reports.
ANTHROPIC_API_KEY=sk-ant-your-key

# Model names are configurable so a model can be swapped without a deploy.
ANTHROPIC_EXTRACTION_MODEL=claude-sonnet-5
ANTHROPIC_EXPLANATION_MODEL=claude-sonnet-5
ANTHROPIC_REPORT_MODEL=claude-sonnet-5

# --- Stripe ----------------------------------------------------------------
# Use test-mode keys (sk_test_…, whsec_…) until you are ready to charge real
# cards. The subscription PRICE is configured in Stripe, never in this repo.
STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret
STRIPE_PRO_PRICE_ID=price_your-recurring-price-id

# Optional free trial, in days. Leave unset for no trial.
# STRIPE_TRIAL_DAYS=7

# Only needed if you later add Stripe.js in the browser. The current
# integration redirects to Stripe Checkout, so it is not required.
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-key

# --- Application -----------------------------------------------------------
# The public origin, used to build Stripe return URLs. On Vercel this is
# derived automatically; set it explicitly for a custom domain.
# APP_URL=https://netshift.example.com

# --- Limits (all optional; these are the defaults) --------------------------
# Monthly AI document-parse allowance per tier. -1 means unlimited.
# NETSHIFT_FREE_MONTHLY_DOCUMENT_PARSES=5
# NETSHIFT_PRO_MONTHLY_DOCUMENT_PARSES=100

# Monthly Pro-only AI allowances.
# NETSHIFT_PRO_MONTHLY_AI_EXPLANATIONS=60
# NETSHIFT_PRO_MONTHLY_MARKET_REPORTS=30

# Largest accepted upload, in bytes. Default 8 MB.
# NETSHIFT_MAX_DOCUMENT_BYTES=8388608
